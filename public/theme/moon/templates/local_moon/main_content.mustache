{{!
    @template local_moon/main_content
    This template renders the main content area.
}}
<div id="region-main">
    {{#hasregionmainsettingsmenu}}
        <div class="region_main_settings_menu_proxy"></div>
    {{/hasregionmainsettingsmenu}}
    {{#overflow}}
        <div class="container-fluid tertiary-navigation">
            <div class="navitem">
                {{> core/url_select}}
            </div>
        </div>
    {{/overflow}}
    {{#padi_password_page}}
    <div class="padi-login-shell padi-password-shell"><div class="padi-login-brand">
        <a href="../" class="padi-login-home">PADI<span>.</span></a>
        <p class="padi-login-subtitle">Pangan Akademi Digital Indonesia</p>
        <div class="padi-login-message"><p class="padi-login-eyebrow">PORTAL PEMBELAJARAN</p><h2>Belajar hari ini.<br>Berdaya untuk<br><span>pangan Indonesia.</span></h2><p>Ruang belajar dan pengembangan kompetensi Badan Pangan Nasional.</p></div>
        <p class="padi-login-signature">Belajar. Berkembang. Berkontribusi.</p>
    </div>
        <div class="padi-password-form"><h1>{{#str}}passwordforgotten, core{{/str}}</h1>
    {{/padi_password_page}}
    {{{ output.main_content }}}
    {{#padi_password_page}}
        <a class="padi-back-login" href="index.php">{{#str}}login, core{{/str}}</a></div>
    </div>
    {{/padi_password_page}}
</div>